# Copy this file to .env and replace every placeholder.
# Never commit the real .env file.

MOODLE_VERSION=5.0.2
MOODLE_HOST_PORT=8080
MOODLE_WWWROOT=https://learning.example.com

MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle_app
MOODLE_DB_PASSWORD=replace-with-a-long-random-database-password
MARIADB_ROOT_PASSWORD=replace-with-a-different-long-random-root-password

# Used only by the backup and restore scripts.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
