      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{"expr": "probe_duration_seconds", "legendFormat": "Response time", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "type": "timeseries",
      "title": "Container CPU Usage",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 20},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{"expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name!=\"\"}[5m])) * 100", "legendFormat": "{{name}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent"}}
    },
    {
      "type": "timeseries",
      "title": "Container Memory Usage",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 20},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [{"expr": "sum by (name) (container_memory_working_set_bytes{name!=\"\"})", "legendFormat": "{{name}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "bytes"}}
